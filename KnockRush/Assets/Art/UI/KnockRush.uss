/* KnockRush UI theme (UI Toolkit). Brand: Rush Orange #FF6A1A, Knock Purple #5B2EFF,
   Sunny #FFD12B, Mint #22C58B, Bubblegum #FF4F9A, Deep Night #1E145C.
   Body text: Nunito; display text (.kr-display): Lilita One. Both SIL OFL 1.1 (see Fonts/). */

.kr-root {
    flex-grow: 1;
    -unity-font-definition: url("Fonts/Nunito-Variable.ttf");
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    font-size: 26px;
}

.kr-safe {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.kr-screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    padding: 28px 40px;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}

.kr-screen--hidden {
    opacity: 0;
    translate: 0 40px;
}

.kr-backdrop {
    background-color: rgba(30, 20, 92, 0.86);
}

.kr-title {
    font-size: 64px;
    color: rgb(255, 209, 43);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(30, 20, 92);
    -unity-text-align: middle-center;
}

.kr-heading {
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(30, 20, 92);
}

.kr-subtle {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.75);
}

.kr-row {
    flex-direction: row;
    align-items: center;
}

.kr-col {
    flex-direction: column;
}

.kr-grow {
    flex-grow: 1;
}

.kr-spacer {
    flex-grow: 1;
}

.kr-center {
    align-items: center;
    justify-content: center;
}

/* ---------- Buttons ---------- */
.kr-btn {
    background-color: rgb(91, 46, 255);
    border-width: 0;
    border-bottom-width: 6px;
    border-color: rgb(55, 24, 170);
    border-radius: 18px;
    padding: 10px 26px;
    margin: 6px;
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-text-align: middle-center;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.kr-btn:hover {
    background-color: rgb(110, 70, 255);
}

.kr-btn:active {
    scale: 0.95 0.95;
    border-bottom-width: 2px;
}

.kr-btn:disabled {
    opacity: 0.45;
}

.kr-btn--primary {
    background-color: rgb(255, 106, 26);
    border-color: rgb(196, 70, 6);
    font-size: 46px;
    padding: 16px 56px;
}

.kr-btn--primary:hover {
    background-color: rgb(255, 130, 60);
}

.kr-btn--good {
    background-color: rgb(34, 197, 139);
    border-color: rgb(18, 140, 96);
}

.kr-btn--danger {
    background-color: rgb(232, 58, 58);
    border-color: rgb(160, 30, 30);
}

.kr-btn--ghost {
    background-color: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.08);
}

.kr-btn--small {
    font-size: 22px;
    padding: 6px 16px;
    border-bottom-width: 4px;
    border-radius: 12px;
}

.kr-btn--icon {
    width: 84px;
    height: 84px;
    padding: 0;
    border-radius: 24px;
    font-size: 20px;
}

/* ---------- Cards / panels ---------- */
.kr-panel {
    background-color: rgba(30, 20, 92, 0.78);
    border-radius: 24px;
    padding: 20px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.12);
}

.kr-card {
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    padding: 12px;
    margin: 8px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.10);
    align-items: center;
}

.kr-card--selected {
    border-color: rgb(255, 209, 43);
    background-color: rgba(255, 209, 43, 0.22);
}

.kr-card--locked {
    opacity: 0.55;
}

.kr-swatch {
    width: 92px;
    height: 92px;
    border-radius: 46px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.85);
    margin-bottom: 6px;
}

.kr-rarity-common { border-color: rgb(180, 190, 210); }
.kr-rarity-rare { border-color: rgb(45, 156, 255); }
.kr-rarity-epic { border-color: rgb(181, 94, 255); }
.kr-rarity-legendary { border-color: rgb(255, 209, 43); }

/* ---------- Top bar / currencies ---------- */
.kr-topbar {
    flex-direction: row;
    align-items: center;
    height: 92px;
}

.kr-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(30, 20, 92, 0.75);
    border-radius: 30px;
    padding: 6px 18px 6px 8px;
    margin-left: 12px;
    font-size: 28px;
}

.kr-coin {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgb(255, 209, 43);
    border-width: 3px;
    border-color: rgb(214, 160, 20);
    margin-right: 8px;
}

.kr-gem {
    width: 38px;
    height: 38px;
    rotate: 45deg;
    border-radius: 8px;
    background-color: rgb(255, 79, 154);
    border-width: 3px;
    border-color: rgb(196, 40, 110);
    margin-right: 10px;
}

.kr-level {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgb(34, 197, 139);
    border-width: 4px;
    border-color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    font-size: 28px;
}

/* ---------- Progress bars ---------- */
.kr-bar {
    height: 22px;
    border-radius: 11px;
    background-color: rgba(0, 0, 0, 0.35);
    overflow: hidden;
}

.kr-bar__fill {
    height: 100%;
    border-radius: 11px;
    background-color: rgb(255, 209, 43);
}

/* ---------- Tabs ---------- */
.kr-tab {
    background-color: rgba(255, 255, 255, 0.10);
    border-width: 0;
    border-radius: 16px;
    margin: 4px;
    padding: 8px 20px;
    color: rgb(255, 255, 255);
    font-size: 24px;
}

.kr-tab--active {
    background-color: rgb(255, 106, 26);
}

/* ---------- Achievements ---------- */
.kr-achievement {
    flex-direction: row;
    align-items: center;
    width: 820px;
    margin: 10px;
    opacity: 0.8;
}

.kr-achievement--unlocked {
    opacity: 1;
    border-color: rgb(255, 209, 43);
}

.kr-achievement__medal {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    margin-right: 20px;
    font-size: 52px;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.6);
}

.kr-achievement--unlocked .kr-achievement__medal {
    background-color: rgb(255, 209, 43);
    color: rgb(196, 70, 6);
}

.kr-achievement__title {
    font-size: 30px;
}

/* ---------- HUD ---------- */
.kr-hud-banner {
    font-size: 110px;
    color: rgb(255, 209, 43);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(30, 20, 92);
    -unity-text-align: middle-center;
    scale: 1 1;
    transition-property: scale, opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.kr-hud-banner--pop {
    scale: 1.25 1.25;
}

.kr-hud-banner--bad {
    color: rgb(255, 90, 90);
}

.kr-hud-chip {
    background-color: rgba(30, 20, 92, 0.75);
    border-radius: 24px;
    padding: 6px 22px;
    font-size: 30px;
}

.kr-toast {
    background-color: rgba(30, 20, 92, 0.92);
    border-radius: 20px;
    padding: 12px 24px;
    font-size: 26px;
    border-width: 3px;
    border-color: rgb(255, 209, 43);
}

.kr-input {
    font-size: 30px;
    min-width: 260px;
}

.kr-input > #unity-text-input {
    background-color: rgba(255, 255, 255, 0.92);
    color: rgb(30, 20, 92);
    border-radius: 14px;
    padding: 8px 14px;
}

.kr-scroll {
    flex-grow: 1;
}

.kr-wrap {
    flex-direction: row;
    flex-wrap: wrap;
}

/* ---------- Typography ---------- */
.kr-display {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf");
    -unity-font-style: normal;
}

/* ---------- Backdrops ---------- */
.kr-backdrop-solid {
    background-color: rgb(30, 20, 92);
}

.kr-dim {
    background-color: rgba(10, 6, 40, 0.72);
}

/* ---------- Splash / loading ---------- */
.kr-splash {
    background-color: rgb(42, 26, 122);
}

.kr-logo {
    font-size: 180px;
    color: rgb(255, 209, 43);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(196, 70, 6);
    -unity-text-align: middle-center;
    text-shadow: 0 10px 0 rgb(30, 20, 92);
}

.kr-tagline {
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.kr-spinner {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    border-width: 12px;
    border-color: rgba(255, 255, 255, 0.18);
    border-top-color: rgb(255, 106, 26);
    border-right-color: rgb(255, 209, 43);
    margin-bottom: 24px;
}

.kr-tip {
    position: absolute;
    left: 120px;
    right: 120px;
    bottom: 40px;
    font-size: 26px;
    color: rgba(255, 255, 255, 0.85);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Dialogs / sections ---------- */
.kr-dialog {
    width: 980px;
    max-width: 92%;
    align-items: center;
    padding: 32px;
}

.kr-dialog__text {
    font-size: 26px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 16px 0;
}

.kr-section {
    margin: 10px 0;
}

.kr-section__title {
    font-size: 30px;
    color: rgb(255, 209, 43);
    margin: 10px 4px 8px 4px;
}

.kr-slider {
    margin: 8px 0;
    font-size: 24px;
}

.kr-slider > .unity-label {
    min-width: 320px;
    color: rgb(255, 255, 255);
}

.kr-slider #unity-tracker {
    height: 14px;
    margin-top: -7px;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 0;
    border-radius: 7px;
}

.kr-slider #unity-dragger {
    width: 34px;
    height: 34px;
    margin-top: -17px;
    border-radius: 17px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(255, 106, 26);
}

.kr-toggle {
    margin: 8px 0;
    font-size: 24px;
}

.kr-toggle > .unity-label {
    min-width: 320px;
    color: rgb(255, 255, 255);
}

.kr-toggle #unity-checkmark {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.3);
}

.kr-toggle:checked #unity-checkmark {
    background-color: rgb(34, 197, 139);
}

/* ---------- Home (lobby) ----------
   Floating icon buttons with slanted labels around the big character (1920×1080 reference,
   24 px margins). Slanted plates are 9-sliced horizontally only (their textures are drawn at
   the display height). */
.kr-home .kr-display {
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2.5px;
    -unity-text-outline-color: rgb(16, 24, 78);
    text-shadow: 0 3px 0 rgba(16, 24, 78, 0.85);
}

/* Bare skinned button: no default Unity / .kr-btn look, a quick squash when pressed. */
.kr-h-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    margin: 0;
    padding: 0;
    transition-property: scale;
    transition-duration: 0.08s;
}

.kr-h-btn:hover,
.kr-h-btn:focus {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.kr-h-btn:active,
.kr-h-btn:hover:active {
    background-color: rgba(0, 0, 0, 0);
    scale: 0.93 0.93;
}

/* Icons */
.kr-ico {
    -unity-background-scale-mode: scale-to-fit;
    flex-shrink: 0;
}

.kr-ico--alert { background-image: url("Icons/alert.png"); }
.kr-ico--back { background-image: url("Icons/back.png"); }
.kr-ico--cart { background-image: url("Icons/cart.png"); }
.kr-ico--clock { background-image: url("Icons/clock.png"); }
.kr-ico--coin { background-image: url("Icons/coin.png"); }
.kr-ico--crown { background-image: url("Icons/crown.png"); }
.kr-ico--edit { background-image: url("Icons/edit.png"); }
.kr-ico--friends { background-image: url("Icons/friends.png"); }
.kr-ico--gem { background-image: url("Icons/gem.png"); }
.kr-ico--gift { background-image: url("Icons/gift.png"); }
.kr-ico--hanger { background-image: url("Icons/hanger.png"); }
.kr-ico--medal { background-image: url("Icons/medal.png"); }
.kr-ico--missions { background-image: url("Icons/missions.png"); }
.kr-ico--modes { background-image: url("Icons/modes.png"); }
.kr-ico--party { background-image: url("Icons/party.png"); }
.kr-ico--pass { background-image: url("Icons/pass_star.png"); }
.kr-ico--person { background-image: url("Icons/person.png"); }
.kr-ico--play { background-image: url("Icons/play_arrows.png"); }
.kr-ico--plus { background-image: url("Icons/plus.png"); }
.kr-ico--settings { background-image: url("Icons/settings.png"); }
.kr-ico--stopwatch { background-image: url("Icons/stopwatch.png"); }
.kr-ico--trophy { background-image: url("Icons/trophy.png"); }

.kr-h-offline {
    position: absolute;
    top: 28px;
    left: 50%;
    translate: -50% 0;
    padding: 4px 18px;
    border-radius: 16px;
    background-color: rgba(232, 58, 58, 0.92);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
}

.kr-h-offline .kr-display {
    font-size: 20px;
}

/* ---- Profile: avatar, level hexagon, slanted name plate, XP ---- */
.kr-h2-profile {
    position: absolute;
    top: 20px;
    left: 24px;
    flex-direction: row;
    align-items: center;
}

.kr-h-avatar {
    width: 108px;
    height: 108px;
    padding: 7px;
    background-image: url("Skins/frame_gold.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
}

.kr-h-avatar__inner {
    flex-grow: 1;
    background-image: url("Skins/avatar_bg.png");
    -unity-slice-left: 22;
    -unity-slice-right: 22;
    -unity-slice-top: 22;
    -unity-slice-bottom: 22;
    border-radius: 18px;
    overflow: hidden;
}

.kr-h-avatar__image {
    flex-grow: 1;
    -unity-background-scale-mode: scale-and-crop;
}

.kr-h2-hex {
    width: 64px;
    height: 64px;
    align-items: center;
    justify-content: center;
    background-image: url("Skins/hex_level.png");
    -unity-background-scale-mode: scale-to-fit;
}

.kr-h2-profile > .kr-h2-hex {
    position: absolute;
    left: 74px;
    top: 66px;
}

.kr-home .kr-h2-hex__text {
    font-size: 30px;
    -unity-text-align: middle-center;
}

.kr-h2-profile__info {
    margin-left: 22px;
}

.kr-h2-nameplate {
    height: 64px;
    min-width: 280px;
    padding: 0 40px 0 30px;
    align-items: center;
    background-image: url("Skins/plate_name.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.kr-home .kr-h2-nameplate__text {
    font-size: 32px;
    color: rgb(28, 38, 110);
    -unity-font-style: italic;
    -unity-text-outline-width: 0;
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.kr-h2-xp {
    width: 240px;
    height: 18px;
    margin: 8px 0 0 14px;
    padding: 3px;
    background-image: url("Skins/bar_track.png");
    -unity-slice-left: 8;
    -unity-slice-right: 8;
    -unity-slice-top: 8;
    -unity-slice-bottom: 8;
}

.kr-h2-xp__fill {
    height: 100%;
    background-image: url("Skins/bar_fill.png");
    -unity-slice-left: 6;
    -unity-slice-right: 6;
    -unity-slice-top: 6;
    -unity-slice-bottom: 6;
}

/* ---- Top-right: wallet plates + settings gear ---- */
.kr-h2-topright {
    position: absolute;
    top: 30px;
    right: 24px;
    flex-direction: row;
    align-items: center;
}

.kr-h2-wallet {
    flex-direction: row;
    align-items: center;
    width: 250px;
    height: 64px;
    margin-left: 26px;
    padding: 0 26px 0 64px;
    background-image: url("Skins/plate_navy.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.kr-h2-wallet__icon {
    position: absolute;
    left: -14px;
    top: -8px;
    width: 78px;
    height: 78px;
}

.kr-home .kr-h2-wallet__value {
    flex-grow: 1;
    font-size: 32px;
    -unity-font-style: italic;
    -unity-text-align: middle-left;
}

.kr-h2-wallet__plus {
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    padding-bottom: 4px;
    background-image: url("Skins/btn_green.png");
    -unity-slice-left: 18;
    -unity-slice-right: 18;
    -unity-slice-top: 18;
    -unity-slice-bottom: 24;
}

.kr-h2-wallet__plusicon {
    width: 24px;
    height: 24px;
}

.kr-h2-gear {
    width: 88px;
    height: 88px;
    margin-left: 22px;
}

.kr-h2-gear__icon {
    flex-grow: 1;
}

/* ---- Floating icon tiles ---- */
.kr-h2-left,
.kr-h2-right {
    position: absolute;
    top: 160px;
    align-items: center;
}

.kr-h2-left {
    left: 16px;
}

.kr-h2-right {
    right: 16px;
}

.kr-h2-bottomtiles {
    position: absolute;
    left: 490px;
    bottom: 14px;
    flex-direction: row;
    align-items: flex-end;
}

.kr-h2-tile {
    width: 150px;
    align-items: center;
    margin-bottom: 4px;
}

.kr-h2-tile__icon {
    width: 104px;
    height: 104px;
}

.kr-home .kr-h2-tile__label {
    font-size: 27px;
    margin-top: -16px;
    -unity-font-style: italic;
    -unity-text-outline-width: 3px;
    rotate: -4deg;
}

.kr-home .kr-h2-tile__sub {
    font-size: 20px;
    margin-top: -2px;
    color: rgb(255, 222, 90);
    -unity-font-style: italic;
}

.kr-h2-tile__badge {
    position: absolute;
    top: 0;
    right: 18px;
    width: 36px;
    height: 36px;
}

/* ---- Rush Pass banner ---- */
.kr-h2-pass {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 440px;
    height: 110px;
    flex-direction: row;
    align-items: center;
    padding: 0 22px 8px 104px;
    background-image: url("Skins/pass_banner.png");
    -unity-slice-left: 44;
    -unity-slice-right: 44;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.kr-h2-pass__star {
    position: absolute;
    left: -10px;
    top: -26px;
    width: 124px;
    height: 124px;
    rotate: -10deg;
}

.kr-h2-pass__text {
    flex-grow: 1;
}

.kr-home .kr-h2-pass__title {
    font-size: 42px;
    -unity-font-style: italic;
    -unity-text-outline-width: 3px;
}

.kr-home .kr-h2-pass__time {
    font-size: 20px;
    margin-top: -6px;
    color: rgb(255, 236, 140);
    -unity-font-style: italic;
}

.kr-h2-pass__hex {
    width: 78px;
    height: 78px;
}

/* ---- PLAY + selected mode ---- */
.kr-h2-playgroup {
    position: absolute;
    right: 24px;
    bottom: 24px;
    align-items: flex-end;
}

.kr-h2-modeplate {
    flex-direction: row;
    align-items: center;
    height: 64px;
    margin: 0 36px 10px 0;
    padding: 0 40px 0 74px;
    background-image: url("Skins/plate_navy.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.kr-h2-modeplate__icon {
    position: absolute;
    left: 14px;
    top: 2px;
    width: 58px;
    height: 58px;
}

.kr-home .kr-h2-modeplate__text {
    font-size: 26px;
    -unity-font-style: italic;
}

.kr-h2-play {
    width: 520px;
    height: 150px;
    align-items: center;
    justify-content: center;
    padding-bottom: 6px;
    background-image: url("Skins/play_slanted.png");
    -unity-slice-left: 56;
    -unity-slice-right: 56;
    -unity-slice-top: 0;
    -unity-slice-bottom: 0;
}

.kr-home .kr-h2-play__text {
    font-size: 104px;
    -unity-font-style: italic;
    -unity-text-outline-width: 5px;
    -unity-text-outline-color: rgb(120, 50, 0);
    text-shadow: 0 6px 0 rgba(120, 50, 0, 0.9);
}

.kr-missions {
    width: 900px;
}

.kr-missions__list {
    width: 100%;
    margin: 16px 0;
}

.kr-mission {
    margin: 8px 0;
    font-size: 22px;
}

/* ---------- Modes / rooms / lobby ---------- */
.kr-mode-card {
    width: 560px;
    height: 600px;
    margin: 16px;
    align-items: center;
}

.kr-mode-card__text {
    font-size: 26px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 18px 0;
}

.kr-lobby {
    align-self: center;
    align-items: center;
    margin-top: 40px;
    width: 1200px;
    max-width: 96%;
}

.kr-room-code {
    font-size: 56px;
    color: rgb(255, 209, 43);
    margin: 0 18px;
    letter-spacing: 6px;
}

.kr-lobby-grid {
    justify-content: center;
    margin: 18px 0;
    max-width: 1000px;
}

.kr-lobby-dot {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    margin: 6px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.35);
}

.kr-lobby-dot--you {
    border-color: rgb(255, 209, 43);
    border-width: 5px;
    scale: 1.2 1.2;
}

.kr-lobby-dot--bot {
    opacity: 0.75;
}

/* ---------- Lists ---------- */
.kr-list-row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 10px 18px;
    margin: 5px 0;
    font-size: 26px;
}

.kr-list-head {
    background-color: rgba(0, 0, 0, 0);
    color: rgba(255, 255, 255, 0.7);
}

.kr-list-row--top {
    background-color: rgba(255, 209, 43, 0.16);
}

.kr-list-row--you {
    border-width: 3px;
    border-color: rgb(34, 197, 139);
}

.kr-avatar {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    margin-right: 14px;
    font-size: 28px;
    -unity-text-align: middle-center;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.8);
}

/* ---------- Profile ---------- */
.kr-profile-card {
    width: 620px;
    align-items: center;
    margin-right: 24px;
}

.kr-level--big {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    font-size: 56px;
}

.kr-stat {
    width: 330px;
    margin: 10px;
    align-items: center;
}

.kr-stat__value {
    font-size: 64px;
    color: rgb(255, 209, 43);
}

/* ---------- Item cards / locker ---------- */
.kr-item {
    width: 200px;
    height: 220px;
    padding: 10px;
    justify-content: center;
}

.kr-item:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.kr-swatch__text {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    font-size: 30px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(30, 20, 92);
}

.kr-item__name {
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
    height: 50px;
}

.kr-item__status {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.85);
}

.kr-item__status--equipped {
    color: rgb(34, 197, 139);
}

.kr-locker-panel {
    width: 960px;
    margin-left: 12px;
    background-color: rgba(30, 20, 92, 0.94);
}

.kr-scroll .unity-scroller--vertical {
    width: 14px;
}

.kr-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
    border-radius: 7px;
}

.kr-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.45);
    border-width: 0;
    border-radius: 7px;
}

.kr-scroll .unity-scroller .unity-repeat-button {
    display: none;
}

.kr-arrow {
    font-size: 48px;
    align-self: center;
}

/* ---------- Shop / season ---------- */
.kr-bundle {
    width: 820px;
    margin: 12px;
    align-items: center;
}

.kr-gem-pack {
    width: 330px;
    height: 420px;
    margin: 14px;
    align-items: center;
    justify-content: space-around;
}

.kr-season-summary {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.kr-tier {
    width: 200px;
    margin: 0 6px;
    padding: 8px;
    border-radius: 18px;
    background-color: rgba(255, 255, 255, 0.06);
    align-items: center;
}

.kr-tier--reached {
    background-color: rgba(34, 197, 139, 0.22);
}

.kr-tier__number {
    font-size: 36px;
}

.kr-reward {
    width: 180px;
    height: 250px;
    margin: 6px 0;
    padding: 8px;
    border-radius: 16px;
    background-color: rgba(30, 20, 92, 0.75);
    align-items: center;
    justify-content: space-around;
}

.kr-reward--premium {
    background-color: rgba(255, 170, 20, 0.28);
    border-width: 3px;
    border-color: rgb(255, 209, 43);
}

.kr-reward__text {
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---------- HUD ---------- */
.kr-hud-top {
    flex-direction: row;
    align-items: flex-start;
}

.kr-hud-chip--hurry {
    background-color: rgba(232, 58, 58, 0.9);
}

.kr-crown {
    width: 220px;
    height: 120px;
    background-color: rgb(255, 209, 43);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
    border-width: 6px;
    border-color: rgb(214, 160, 20);
    margin-bottom: 10px;
}

/* ---------- Key-art splash & loading (matches the KnockRush key art) ---------- */
.kr-keyart {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(45, 139, 240);
    /* Fill the screen, anchored to the top: on tall/wide phones the logo stays fully visible
       and only the (blurred) bottom band under the loading bar is cropped. */
    background-size: cover;
    background-position-x: center;
    background-position-y: top;
}

.kr-keyart-screen {
    padding: 0;
}

.kr-keyart-dock {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 4%;
    align-items: center;
}

.kr-keyart-title {
    font-size: 54px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(20, 28, 88);
    text-shadow: 0 4px 0 rgb(20, 28, 88);
    margin-bottom: 6px;
}

.kr-keyart-row {
    flex-direction: row;
    align-items: center;
    width: 62%;
    justify-content: center;
}

.kr-keyart-track {
    flex-grow: 1;
    height: 52px;
    border-radius: 26px;
    border-width: 5px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(18, 30, 92);
    overflow: hidden;
    padding: 4px;
}

.kr-keyart-fill {
    height: 100%;
    border-radius: 18px;
    background-color: rgb(255, 196, 18);
    overflow: hidden;
}

.kr-keyart-gloss {
    position: absolute;
    left: 6px;
    right: 6px;
    top: 3px;
    height: 40%;
    border-radius: 10px;
    background-color: rgba(255, 240, 160, 0.75);
}

.kr-keyart-stripes {
    position: absolute;
    left: 0;
    top: -20px;
    bottom: -20px;
    flex-direction: row;
    width: 2400px;
}

.kr-keyart-stripe {
    width: 18px;
    height: 100%;
    margin-right: 30px;
    rotate: 28deg;
    background-color: rgba(255, 150, 0, 0.42);
}

.kr-keyart-percent {
    width: 150px;
    margin-left: 18px;
    font-size: 54px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(20, 28, 88);
    text-shadow: 0 4px 0 rgb(20, 28, 88);
}

.kr-keyart-tagline {
    margin-top: 12px;
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(20, 28, 88);
    text-shadow: 0 3px 0 rgb(20, 28, 88);
}

.kr-keyart-context {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 25%;
    font-size: 42px;
    color: rgb(255, 209, 43);
    -unity-text-align: middle-center;
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(20, 28, 88);
}

/* =====================================================================================
   Premium skin layer (applies the Home look to every screen). Declared last so it
   overrides the base styles above: glossy 9-slice buttons, navy panels, card skins,
   full-screen page backdrops and a common header (round back button + title).
   ===================================================================================== */

/* ---- Page backdrop (menu pages are their own screens) ---- */
.kr-page-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-image: url("Backgrounds/PageBackground.png");
    -unity-background-scale-mode: scale-and-crop;
}

.kr-in-menu .kr-backdrop {
    background-color: rgba(0, 0, 0, 0);
}

.kr-screen {
    padding: 24px 32px;
}

/* ---- Display text: white with a navy outline and drop shadow everywhere ---- */
.kr-display {
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(16, 24, 78);
    text-shadow: 0 3px 0 rgba(16, 24, 78, 0.8);
}

.kr-title {
    font-size: 60px;
    color: rgb(255, 214, 60);
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf");
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(16, 24, 78);
    text-shadow: 0 4px 0 rgba(16, 24, 78, 0.9);
}

.kr-heading {
    font-size: 38px;
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf");
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(16, 24, 78);
    text-shadow: 0 3px 0 rgba(16, 24, 78, 0.85);
}

/* ---- Header: round back button + big title ---- */
.kr-topbar {
    height: 96px;
    margin-bottom: 12px;
}

.kr-page-title {
    font-size: 52px;
    margin-left: 20px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 3px;
    text-shadow: 0 4px 0 rgba(16, 24, 78, 0.9);
}

.kr-btn.kr-btn--back {
    width: 84px;
    height: 84px;
    margin: 0;
    padding: 0 0 8px 0;
    align-items: center;
    justify-content: center;
    background-image: url("Skins/btn_blue.png");
    -unity-slice-left: 26;
    -unity-slice-right: 26;
    -unity-slice-top: 26;
    -unity-slice-bottom: 34;
}

.kr-btn--back__icon {
    width: 50px;
    height: 50px;
}

/* ---- Buttons: glossy skins (blue default, yellow primary, green good, red danger, navy ghost) ---- */
.kr-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding: 12px 30px 20px 30px;
    margin: 6px;
    font-size: 28px;
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf");
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(16, 24, 78);
    text-shadow: 0 3px 0 rgba(16, 24, 78, 0.8);
    background-image: url("Skins/btn_blue.png");
    -unity-slice-left: 26;
    -unity-slice-right: 26;
    -unity-slice-top: 26;
    -unity-slice-bottom: 34;
}

.kr-btn:hover,
.kr-btn:focus {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
}

.kr-btn:active,
.kr-btn:hover:active {
    background-color: rgba(0, 0, 0, 0);
    scale: 0.95 0.95;
    border-bottom-width: 0;
}

.kr-btn--primary {
    background-image: url("Skins/btn_yellow.png");
    -unity-slice-left: 42;
    -unity-slice-right: 42;
    -unity-slice-top: 42;
    -unity-slice-bottom: 50;
    font-size: 44px;
    padding: 14px 54px 24px 54px;
    -unity-text-outline-color: rgb(120, 50, 0);
    text-shadow: 0 4px 0 rgba(120, 50, 0, 0.85);
}

.kr-btn--good {
    background-image: url("Skins/btn_green.png");
    -unity-text-outline-color: rgb(10, 70, 30);
    text-shadow: 0 3px 0 rgba(10, 70, 30, 0.8);
}

.kr-btn--danger {
    background-image: url("Skins/btn_red.png");
    -unity-text-outline-color: rgb(110, 10, 30);
    text-shadow: 0 3px 0 rgba(110, 10, 30, 0.8);
}

.kr-btn--ghost {
    background-image: url("Skins/panel_navy.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    padding: 12px 28px 14px 28px;
}

.kr-btn--small {
    font-size: 22px;
    padding: 8px 20px 14px 20px;
}

.kr-btn--ghost.kr-btn--small {
    padding: 8px 20px 10px 20px;
}

.kr-btn:disabled {
    opacity: 0.5;
}

/* ---- Panels, cards, dialogs ---- */
.kr-panel,
.kr-dialog,
.kr-locker-panel,
.kr-season-summary,
.kr-profile-card {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    background-image: url("Skins/panel_navy.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    padding: 22px 26px;
}

.kr-card,
.kr-item,
.kr-mode-card,
.kr-bundle,
.kr-gem-pack,
.kr-tier,
.kr-achievement {
    background-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    border-width: 0;
    background-image: url("Skins/card_blue.png");
    -unity-slice-left: 40;
    -unity-slice-right: 40;
    -unity-slice-top: 40;
    -unity-slice-bottom: 40;
}

.kr-item:hover {
    background-color: rgba(0, 0, 0, 0);
}

.kr-card--selected,
.kr-achievement--unlocked,
.kr-tier--reached {
    background-image: url("Skins/card_blue_sel.png");
    -unity-slice-left: 48;
    -unity-slice-right: 48;
    -unity-slice-top: 48;
    -unity-slice-bottom: 48;
}

.kr-reward--premium,
.kr-gem-pack {
    background-image: url("Skins/card_purple.png");
}

/* Rarity: a coloured bottom strip instead of a border around the skin. */
.kr-rarity-common,
.kr-rarity-rare,
.kr-rarity-epic,
.kr-rarity-legendary {
    border-bottom-width: 6px;
    border-bottom-left-radius: 22px;
    border-bottom-right-radius: 22px;
}

/* ---- Lists (leaderboard, friends) ---- */
.kr-list-row {
    background-color: rgba(16, 28, 96, 0.72);
    border-radius: 18px;
    border-width: 2px;
    border-color: rgba(140, 180, 255, 0.35);
    margin: 4px 0;
    padding: 10px 18px;
}

.kr-list-row--you {
    background-color: rgba(255, 196, 46, 0.35);
    border-color: rgb(255, 214, 60);
}

/* ---- Currency pills (shop / season headers) ---- */
.kr-pill {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    background-image: url("Skins/panel_navy.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
    padding: 8px 22px 8px 10px;
    height: 64px;
    margin-left: 14px;
}

.kr-coin,
.kr-gem {
    width: 50px;
    height: 50px;
    margin-right: 10px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-to-fit;
}

.kr-coin { background-image: url("Icons/coin.png"); }
.kr-gem { background-image: url("Icons/gem.png"); rotate: 0deg; }

/* ---- Tabs (shop, locker) ---- */
.kr-tab {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    background-image: url("Skins/panel_navy.png");
    -unity-slice-left: 30;
    -unity-slice-right: 30;
    -unity-slice-top: 30;
    -unity-slice-bottom: 30;
}

.kr-tab--active {
    background-image: url("Skins/btn_yellow.png");
    -unity-slice-left: 26;
    -unity-slice-right: 26;
    -unity-slice-top: 26;
    -unity-slice-bottom: 32;
    -unity-text-outline-color: rgb(120, 50, 0);
}

/* ---- Progress bars ---- */
.kr-bar {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    background-image: url("Skins/bar_track.png");
    -unity-slice-left: 14;
    -unity-slice-right: 14;
    -unity-slice-top: 14;
    -unity-slice-bottom: 14;
    padding: 3px;
}

.kr-bar__fill {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("Skins/bar_fill.png");
    -unity-slice-left: 11;
    -unity-slice-right: 11;
    -unity-slice-top: 11;
    -unity-slice-bottom: 11;
}

/* ---- Inputs, toggles, mode cards ---- */
.kr-input > #unity-text-input {
    background-color: rgb(255, 255, 255);
    border-width: 3px;
    border-color: rgb(16, 24, 78);
    border-radius: 16px;
    padding: 8px 16px;
    color: rgb(28, 38, 110);
    font-size: 26px;
}

.kr-toggle #unity-checkmark {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    border-width: 3px;
    border-color: rgb(16, 24, 78);
    background-color: rgb(255, 255, 255);
}

.kr-toggle:checked #unity-checkmark {
    background-color: rgb(60, 200, 90);
}

.kr-mode-card {
    height: 440px;
    padding: 24px;
}

.kr-dialog {
    padding: 28px 36px;
}

/* ---- Characters (wardrobe) ---- */
.kr-portrait {
    width: 132px;
    height: 132px;
    margin-bottom: 4px;
    border-radius: 66px;
    background-color: rgba(160, 215, 255, 0.55);
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.85);
    -unity-background-scale-mode: scale-and-crop;
}

.kr-character-info {
    margin-bottom: 12px;
}

.kr-character-rarity {
    font-size: 26px;
    margin-bottom: 8px;
}
