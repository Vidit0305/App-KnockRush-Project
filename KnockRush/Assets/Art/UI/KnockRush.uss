/* KnockRush UI theme (UI Toolkit). Brand: Rush Orange #FF6A1A, Knock Purple #5B2EFF,
   Sunny #FFD12B, Mint #22C58B, Bubblegum #FF4F9A, Deep Night #1E145C.
   Body text: Nunito; display text (.kr-display): Lilita One. Both SIL OFL 1.1 (see Fonts/). */

.kr-root {
    flex-grow: 1;
    -unity-font-definition: url("Fonts/Nunito-Variable.ttf");
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    font-size: 26px;
}

.kr-safe {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.kr-screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    padding: 28px 40px;
    opacity: 1;
    translate: 0 0;
    transition-property: opacity, translate;
    transition-duration: 0.22s;
    transition-timing-function: ease-out-cubic;
}

.kr-screen--hidden {
    opacity: 0;
    translate: 0 40px;
}

.kr-backdrop {
    background-color: rgba(30, 20, 92, 0.86);
}

.kr-title {
    font-size: 64px;
    color: rgb(255, 209, 43);
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(30, 20, 92);
    -unity-text-align: middle-center;
}

.kr-heading {
    font-size: 40px;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(30, 20, 92);
}

.kr-subtle {
    font-size: 22px;
    color: rgba(255, 255, 255, 0.75);
}

.kr-row {
    flex-direction: row;
    align-items: center;
}

.kr-col {
    flex-direction: column;
}

.kr-grow {
    flex-grow: 1;
}

.kr-spacer {
    flex-grow: 1;
}

.kr-center {
    align-items: center;
    justify-content: center;
}

/* ---------- Buttons ---------- */
.kr-btn {
    background-color: rgb(91, 46, 255);
    border-width: 0;
    border-bottom-width: 6px;
    border-color: rgb(55, 24, 170);
    border-radius: 18px;
    padding: 10px 26px;
    margin: 6px;
    color: rgb(255, 255, 255);
    font-size: 28px;
    -unity-text-align: middle-center;
    transition-property: scale, background-color;
    transition-duration: 0.08s;
}

.kr-btn:hover {
    background-color: rgb(110, 70, 255);
}

.kr-btn:active {
    scale: 0.95 0.95;
    border-bottom-width: 2px;
}

.kr-btn:disabled {
    opacity: 0.45;
}

.kr-btn--primary {
    background-color: rgb(255, 106, 26);
    border-color: rgb(196, 70, 6);
    font-size: 46px;
    padding: 16px 56px;
}

.kr-btn--primary:hover {
    background-color: rgb(255, 130, 60);
}

.kr-btn--good {
    background-color: rgb(34, 197, 139);
    border-color: rgb(18, 140, 96);
}

.kr-btn--danger {
    background-color: rgb(232, 58, 58);
    border-color: rgb(160, 30, 30);
}

.kr-btn--ghost {
    background-color: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.08);
}

.kr-btn--small {
    font-size: 22px;
    padding: 6px 16px;
    border-bottom-width: 4px;
    border-radius: 12px;
}

.kr-btn--icon {
    width: 84px;
    height: 84px;
    padding: 0;
    border-radius: 24px;
    font-size: 20px;
}

/* ---------- Cards / panels ---------- */
.kr-panel {
    background-color: rgba(30, 20, 92, 0.78);
    border-radius: 24px;
    padding: 20px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.12);
}

.kr-card {
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    padding: 12px;
    margin: 8px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.10);
    align-items: center;
}

.kr-card--selected {
    border-color: rgb(255, 209, 43);
    background-color: rgba(255, 209, 43, 0.22);
}

.kr-card--locked {
    opacity: 0.55;
}

.kr-swatch {
    width: 92px;
    height: 92px;
    border-radius: 46px;
    border-width: 4px;
    border-color: rgba(255, 255, 255, 0.85);
    margin-bottom: 6px;
}

.kr-rarity-common { border-color: rgb(180, 190, 210); }
.kr-rarity-rare { border-color: rgb(45, 156, 255); }
.kr-rarity-epic { border-color: rgb(181, 94, 255); }
.kr-rarity-legendary { border-color: rgb(255, 209, 43); }

/* ---------- Top bar / currencies ---------- */
.kr-topbar {
    flex-direction: row;
    align-items: center;
    height: 92px;
}

.kr-pill {
    flex-direction: row;
    align-items: center;
    background-color: rgba(30, 20, 92, 0.75);
    border-radius: 30px;
    padding: 6px 18px 6px 8px;
    margin-left: 12px;
    font-size: 28px;
}

.kr-coin {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background-color: rgb(255, 209, 43);
    border-width: 3px;
    border-color: rgb(214, 160, 20);
    margin-right: 8px;
}

.kr-gem {
    width: 38px;
    height: 38px;
    rotate: 45deg;
    border-radius: 8px;
    background-color: rgb(255, 79, 154);
    border-width: 3px;
    border-color: rgb(196, 40, 110);
    margin-right: 10px;
}

.kr-level {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    background-color: rgb(34, 197, 139);
    border-width: 4px;
    border-color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    font-size: 28px;
}

/* ---------- Progress bars ---------- */
.kr-bar {
    height: 22px;
    border-radius: 11px;
    background-color: rgba(0, 0, 0, 0.35);
    overflow: hidden;
}

.kr-bar__fill {
    height: 100%;
    border-radius: 11px;
    background-color: rgb(255, 209, 43);
}

/* ---------- Tabs ---------- */
.kr-tab {
    background-color: rgba(255, 255, 255, 0.10);
    border-width: 0;
    border-radius: 16px;
    margin: 4px;
    padding: 8px 20px;
    color: rgb(255, 255, 255);
    font-size: 24px;
}

.kr-tab--active {
    background-color: rgb(255, 106, 26);
}

/* ---------- HUD ---------- */
.kr-hud-banner {
    font-size: 110px;
    color: rgb(255, 209, 43);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(30, 20, 92);
    -unity-text-align: middle-center;
    scale: 1 1;
    transition-property: scale, opacity;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.kr-hud-banner--pop {
    scale: 1.25 1.25;
}

.kr-hud-banner--bad {
    color: rgb(255, 90, 90);
}

.kr-hud-chip {
    background-color: rgba(30, 20, 92, 0.75);
    border-radius: 24px;
    padding: 6px 22px;
    font-size: 30px;
}

.kr-toast {
    background-color: rgba(30, 20, 92, 0.92);
    border-radius: 20px;
    padding: 12px 24px;
    font-size: 26px;
    border-width: 3px;
    border-color: rgb(255, 209, 43);
}

.kr-input {
    font-size: 30px;
    min-width: 260px;
}

.kr-input > #unity-text-input {
    background-color: rgba(255, 255, 255, 0.92);
    color: rgb(30, 20, 92);
    border-radius: 14px;
    padding: 8px 14px;
}

.kr-scroll {
    flex-grow: 1;
}

.kr-wrap {
    flex-direction: row;
    flex-wrap: wrap;
}

/* ---------- Typography ---------- */
.kr-display {
    -unity-font-definition: url("Fonts/LilitaOne-Regular.ttf");
    -unity-font-style: normal;
}

/* ---------- Backdrops ---------- */
.kr-backdrop-solid {
    background-color: rgb(30, 20, 92);
}

.kr-dim {
    background-color: rgba(10, 6, 40, 0.72);
}

/* ---------- Splash / loading ---------- */
.kr-splash {
    background-color: rgb(42, 26, 122);
}

.kr-logo {
    font-size: 180px;
    color: rgb(255, 209, 43);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(196, 70, 6);
    -unity-text-align: middle-center;
    text-shadow: 0 10px 0 rgb(30, 20, 92);
}

.kr-tagline {
    font-size: 36px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.kr-spinner {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    border-width: 12px;
    border-color: rgba(255, 255, 255, 0.18);
    border-top-color: rgb(255, 106, 26);
    border-right-color: rgb(255, 209, 43);
    margin-bottom: 24px;
}

.kr-tip {
    position: absolute;
    left: 120px;
    right: 120px;
    bottom: 40px;
    font-size: 26px;
    color: rgba(255, 255, 255, 0.85);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* ---------- Dialogs / sections ---------- */
.kr-dialog {
    width: 980px;
    max-width: 92%;
    align-items: center;
    padding: 32px;
}

.kr-dialog__text {
    font-size: 26px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 16px 0;
}

.kr-section {
    margin: 10px 0;
}

.kr-section__title {
    font-size: 30px;
    color: rgb(255, 209, 43);
    margin: 10px 4px 8px 4px;
}

.kr-slider {
    margin: 8px 0;
    font-size: 24px;
}

.kr-slider > .unity-label {
    min-width: 320px;
    color: rgb(255, 255, 255);
}

.kr-slider #unity-tracker {
    height: 14px;
    margin-top: -7px;
    background-color: rgba(0, 0, 0, 0.35);
    border-width: 0;
    border-radius: 7px;
}

.kr-slider #unity-dragger {
    width: 34px;
    height: 34px;
    margin-top: -17px;
    border-radius: 17px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    background-color: rgb(255, 106, 26);
}

.kr-toggle {
    margin: 8px 0;
    font-size: 24px;
}

.kr-toggle > .unity-label {
    min-width: 320px;
    color: rgb(255, 255, 255);
}

.kr-toggle #unity-checkmark {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    border-width: 3px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0.3);
}

.kr-toggle:checked #unity-checkmark {
    background-color: rgb(34, 197, 139);
}

/* ---------- Home ---------- */
.kr-profile-chip {
    flex-direction: row;
    align-items: center;
    background-color: rgba(30, 20, 92, 0.75);
    border-radius: 40px;
    padding: 6px 22px 6px 6px;
}

.kr-offline {
    align-self: center;
    background-color: rgba(232, 58, 58, 0.85);
    border-radius: 16px;
    padding: 4px 18px;
    font-size: 22px;
}

.kr-home-menu {
    width: 300px;
    justify-content: center;
}

.kr-menu-btn {
    align-items: flex-start;
    padding: 12px 24px;
    margin: 8px 0;
}

.kr-menu-btn__title {
    font-size: 38px;
}

.kr-menu-btn__sub {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.8);
}

.kr-btn--shop { background-color: rgb(255, 79, 154); border-color: rgb(196, 40, 110); }
.kr-btn--locker { background-color: rgb(91, 46, 255); border-color: rgb(55, 24, 170); }
.kr-btn--season { background-color: rgb(255, 170, 20); border-color: rgb(200, 120, 0); }
.kr-btn--friends { background-color: rgb(34, 197, 139); border-color: rgb(18, 140, 96); }

.kr-home-side {
    width: 460px;
    justify-content: center;
}

.kr-mission {
    margin: 8px 0;
    font-size: 22px;
}

.kr-home-bottom {
    flex-direction: row;
    align-items: flex-end;
    height: 150px;
}

.kr-mode-chip {
    background-color: rgba(30, 20, 92, 0.78);
    border-radius: 20px;
    padding: 10px 26px;
    margin-right: 12px;
    align-items: flex-end;
}

.kr-btn--play {
    font-size: 72px;
    padding: 18px 90px;
    border-bottom-width: 10px;
    border-radius: 28px;
}

/* ---------- Modes / rooms / lobby ---------- */
.kr-mode-card {
    width: 560px;
    height: 600px;
    margin: 16px;
    align-items: center;
}

.kr-mode-card__text {
    font-size: 26px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 18px 0;
}

.kr-lobby {
    align-self: center;
    align-items: center;
    margin-top: 40px;
    width: 1200px;
    max-width: 96%;
}

.kr-room-code {
    font-size: 56px;
    color: rgb(255, 209, 43);
    margin: 0 18px;
    letter-spacing: 6px;
}

.kr-lobby-grid {
    justify-content: center;
    margin: 18px 0;
    max-width: 1000px;
}

.kr-lobby-dot {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    margin: 6px;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.35);
}

.kr-lobby-dot--you {
    border-color: rgb(255, 209, 43);
    border-width: 5px;
    scale: 1.2 1.2;
}

.kr-lobby-dot--bot {
    opacity: 0.75;
}

/* ---------- Lists ---------- */
.kr-list-row {
    flex-direction: row;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 10px 18px;
    margin: 5px 0;
    font-size: 26px;
}

.kr-list-head {
    background-color: rgba(0, 0, 0, 0);
    color: rgba(255, 255, 255, 0.7);
}

.kr-list-row--top {
    background-color: rgba(255, 209, 43, 0.16);
}

.kr-list-row--you {
    border-width: 3px;
    border-color: rgb(34, 197, 139);
}

.kr-avatar {
    width: 52px;
    height: 52px;
    border-radius: 26px;
    margin-right: 14px;
    font-size: 28px;
    -unity-text-align: middle-center;
    border-width: 3px;
    border-color: rgba(255, 255, 255, 0.8);
}

/* ---------- Profile ---------- */
.kr-profile-card {
    width: 620px;
    align-items: center;
    margin-right: 24px;
}

.kr-level--big {
    width: 120px;
    height: 120px;
    border-radius: 60px;
    font-size: 56px;
}

.kr-stat {
    width: 330px;
    margin: 10px;
    align-items: center;
}

.kr-stat__value {
    font-size: 64px;
    color: rgb(255, 209, 43);
}

/* ---------- Item cards / locker ---------- */
.kr-item {
    width: 200px;
    height: 220px;
    padding: 10px;
    justify-content: center;
}

.kr-item:hover {
    background-color: rgba(255, 255, 255, 0.2);
}

.kr-swatch__text {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    font-size: 30px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 1.5px;
    -unity-text-outline-color: rgb(30, 20, 92);
}

.kr-item__name {
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
    height: 50px;
}

.kr-item__status {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.85);
}

.kr-item__status--equipped {
    color: rgb(34, 197, 139);
}

.kr-locker-panel {
    width: 960px;
    margin-left: 12px;
    background-color: rgba(30, 20, 92, 0.94);
}

.kr-scroll .unity-scroller--vertical {
    width: 14px;
}

.kr-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
    border-radius: 7px;
}

.kr-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: rgba(255, 255, 255, 0.45);
    border-width: 0;
    border-radius: 7px;
}

.kr-scroll .unity-scroller .unity-repeat-button {
    display: none;
}

.kr-arrow {
    font-size: 48px;
    align-self: center;
}

/* ---------- Shop / season ---------- */
.kr-bundle {
    width: 820px;
    margin: 12px;
    align-items: center;
}

.kr-gem-pack {
    width: 330px;
    height: 420px;
    margin: 14px;
    align-items: center;
    justify-content: space-around;
}

.kr-season-summary {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.kr-tier {
    width: 200px;
    margin: 0 6px;
    padding: 8px;
    border-radius: 18px;
    background-color: rgba(255, 255, 255, 0.06);
    align-items: center;
}

.kr-tier--reached {
    background-color: rgba(34, 197, 139, 0.22);
}

.kr-tier__number {
    font-size: 36px;
}

.kr-reward {
    width: 180px;
    height: 250px;
    margin: 6px 0;
    padding: 8px;
    border-radius: 16px;
    background-color: rgba(30, 20, 92, 0.75);
    align-items: center;
    justify-content: space-around;
}

.kr-reward--premium {
    background-color: rgba(255, 170, 20, 0.28);
    border-width: 3px;
    border-color: rgb(255, 209, 43);
}

.kr-reward__text {
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---------- HUD ---------- */
.kr-hud-top {
    flex-direction: row;
    align-items: flex-start;
}

.kr-hud-chip--hurry {
    background-color: rgba(232, 58, 58, 0.9);
}

.kr-crown {
    width: 220px;
    height: 120px;
    background-color: rgb(255, 209, 43);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
    border-width: 6px;
    border-color: rgb(214, 160, 20);
    margin-bottom: 10px;
}
