{
  "name": "knockrush-functions",
  "private": true,
  "main": "build/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:unit": "npm run build && node --test \"build/test/unit/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"build/test/integration/**/*.test.js\"",
    "test": "npm run test:unit && npm run build && firebase emulators:exec --project demo-knockrush --only auth,firestore,functions \"npm run test:integration\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.6.6",
    "firebase": "^12.19.0",
    "typescript": "^7.0.2"
  }
}
