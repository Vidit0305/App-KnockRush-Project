# =========================================================
# KnockRush repository .gitignore
# Unity project lives in /KnockRush
# =========================================================

# ---------- Unity generated ----------
/KnockRush/[Ll]ibrary/
/KnockRush/[Tt]emp/
/KnockRush/[Oo]bj/
/KnockRush/[Bb]uild/
/KnockRush/[Bb]uilds/
/KnockRush/[Ll]ogs/
/KnockRush/[Uu]ser[Ss]ettings/
/KnockRush/[Mm]emoryCaptures/
/KnockRush/[Rr]ecordings/
/KnockRush/.utmp/
/KnockRush/ServerData/
/KnockRush/Assets/StreamingAssets/aa/
/KnockRush/Assets/StreamingAssets/aa.meta
# Test-runner / build leftovers
/KnockRush/Assets/InitTestScene*.unity*
/KnockRush/Assets/AddressableAssetsData/link.xml*

# Autogenerated IDE / solution files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.vscode/*
!.vscode/extensions.json
.idea/
.consulo/

# Unity crash / profiling output
sysinfo.txt
crashlytics-build.properties
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Build artefacts
*.apk
*.aab
*.ipa
*.symbols.zip
*.app
/Builds/

# ---------- Backend (Firebase, Phase 7) ----------
node_modules/
/Backend/**/lib/
/Backend/**/.firebase/
/Backend/**/firebase-debug.log
/Backend/**/firestore-debug.log
/Backend/**/ui-debug.log

# ---------- Secrets: NEVER commit ----------
.env
.env.*
*.keystore
*.jks
*.p12
*.mobileprovision
service-account*.json
**/secrets/

# ---------- Local tooling / logs ----------
/.logs/
/.tools/

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- Blender autosaves ----------
*.blend1
*.blend2

# ---------- Generated by test runs / services (not project content) ----------
/KnockRush/Assets/Resources/
/KnockRush/Assets/Resources.meta

# Non-secret Cloud Functions parameters
!/Backend/firebase/functions/.env
